{
  "entities": {
    "UserWorkspaceProfile": {
      "title": "UserWorkspaceProfile",
      "description": "Authenticated user workspace preferences synced with Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["English", "Icibemba", "Chinyanja", "Chitonga"]
        },
        "lowDataMode": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "preferredLanguage", "lowDataMode", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII contact record for an authenticated OneGov user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "SavedCivicLocation": {
      "title": "SavedCivicLocation",
      "description": "Bookmarked Zambian civic office, council ward, or Google Maps grounded station.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "institutionCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "zoneCode": {
          "type": "string",
          "maxLength": 40
        },
        "mapsUri": {
          "type": "string",
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "title", "institutionCode", "latitude", "longitude", "createdAt", "updatedAt"]
    },
    "VoiceTranscriptNote": {
      "title": "VoiceTranscriptNote",
      "description": "Saved audio transcription, live voice summary, or grounded AI research note.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "transcript": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sourceType": {
          "type": "string",
          "enum": ["transcription", "live_voice", "search_grounding", "maps_grounding"]
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "title", "transcript", "sourceType", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspaceProfile" },
      "description": "User-scoped workspace language and data-saver profile."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII contact document owned by the user."
    },
    "/savedLocations/{locationId}": {
      "schema": { "$ref": "#/entities/SavedCivicLocation" },
      "description": "User-bookmarked government stations and GIS council revenue wards."
    },
    "/voiceNotes/{noteId}": {
      "schema": { "$ref": "#/entities/VoiceTranscriptNote" },
      "description": "User-saved audio transcriptions, live voice excerpts, and grounded AI citations."
    }
  }
}
